{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Untitled DAW",
  "version": "0.9.0",
  "identifier": "com.untitleddaw.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bun build.mjs",
    "beforeDevCommand": "bun build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Untitled DAW",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#18191c",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Record, arrange and mix music",
    "longDescription": "Untitled DAW is a recording, arranging and mixing app with a Logic-style workflow: audio and MIDI tracks, Piano Roll, Score, Step Sequencer, mixer with plug-ins, automation and movie sync.",
    "copyright": "© 2026 Untitled DAW",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
